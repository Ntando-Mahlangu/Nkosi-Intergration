{
  "name": "leadrecovery",
  "version": "0.2.0",
  "description": "LeadRecovery — AI-powered lead recovery and reactivation system by Nkosi Integrations",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "worker": "tsx src/worker.ts",
    "onboard": "tsx src/scripts/onboardTenant.ts",
    "import-leads": "tsx src/scripts/importLeads.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@sendgrid/mail": "^8.1.3",
    "express": "^4.19.2",
    "multer": "^2.0.0",
    "node-cron": "^4.0.0",
    "pg": "^8.11.5",
    "twilio": "^5.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "pg-mem": "^2.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.15.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
