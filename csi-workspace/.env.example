# CSI Workspace configuration. Copy to .env (never commit .env).
NODE_ENV=development
PORT=4000
# SQLite database file (created automatically).
DATABASE_PATH=./data/csi-workspace.db
# Public base URL (used for OAuth redirect + secure cookies when https).
PUBLIC_URL=http://localhost:4000
# Load fictional demonstration data on first start (never in production with real data).
SEED_DEMO_DATA=true
# Password given to every demo account. Demo only.
DEMO_PASSWORD=
# Initial administrator for a clean (non-demo) install. Used only when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- AI (optional). Without a key, AI features fall back to a clearly labelled rule-based extractor. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Google Workspace sign-in (optional, OpenID Connect) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only allow accounts from this Google Workspace domain (e.g. changescience.org)
GOOGLE_ALLOWED_DOMAIN=
