{
  "name": "csi-workspace",
  "version": "0.1.0",
  "description": "CSI Workspace \u2014 integrated knowledge, meetings, projects and execution platform for Change Science Institute",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist-server/server/index.js",
    "seed": "tsx --disable-warning=ExperimentalWarning server/db/seedCli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo": "npm run build && npm start",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('Local database removed; it will be recreated with demo data on next start.')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  }
}
