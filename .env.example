# Copy to .env (or set these in your host's environment/secrets manager) and fill in.
# Every var here is optional in the sense that omitting all of them runs the
# in-memory demo mode (no external services needed) — see README.md.

# --- Storage ---
# Postgres connection string. Omit entirely to use the in-memory demo store
# (preloaded with the "demo" tenant and data/sample-leads.json).
DATABASE_URL=postgres://user:password@localhost:5432/leadrecovery

# Required whenever DATABASE_URL is set — tenant provider credentials
# (Twilio/SendGrid) are encrypted at rest with this key (AES-256-GCM).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes existing tenants' channel credentials unrecoverable —
# store it in a secrets manager, not in version control.
LEADRECOVERY_ENCRYPTION_KEY=

# Set only while rotating LEADRECOVERY_ENCRYPTION_KEY (see DEPLOYMENT.md
# "Rotating the encryption key"). Lets the app still decrypt tenants not
# yet re-encrypted under the new key. Remove once the rotation script
# reports every tenant re-encrypted.
LEADRECOVERY_ENCRYPTION_KEY_PREVIOUS=

# Max connections in the Postgres pool, shared by whichever process sets it
# (the API server and the worker each keep their own pool). Default 10 (pg's
# own default) is fine for a single small deployment; raise it if you scale
# the app to multiple replicas and see connection contention.
LEADRECOVERY_DB_POOL_MAX=10

# --- API server ---
PORT=3000

# Comma-separated list of origins allowed to call this API cross-origin
# (e.g. https://app.example.com,https://admin.example.com), or "*" for any.
# Unset (the default) sends no CORS headers at all — fine as long as only
# the bundled dashboards (served same-origin) call the API. Only needed if
# you build a separate frontend that calls this API from its own origin.
LEADRECOVERY_CORS_ORIGIN=

# This app's own public HTTPS base URL (no trailing slash), e.g.
# https://leadrecovery.example.com. Required for: (a) correct Twilio webhook
# signature verification when the app sits behind a proxy/load balancer that
# doesn't forward the original scheme/host, and (b) building Twilio
# statusCallback URLs for SMS/WhatsApp delivery-status tracking. Safe to
# leave unset for local development. Set this any time the app is reachable
# from the public internet — including with no reverse proxy in front of it
# at all — so it's deliberately unrelated to TRUST_PROXY_HOPS below.
PUBLIC_BASE_URL=

# Tells Express to trust exactly this many reverse-proxy hops (`trust
# proxy`) so every rate limiter in middleware/rateLimit.ts keys on the real
# client's IP instead of the proxy's. Unset (the default): trust proxy is
# never enabled, and req.ip is always the direct socket peer — safe, but
# means every client sharing one reverse proxy shares one rate-limit bucket.
# Only set this once you've verified your actual proxy overwrites/appends
# X-Forwarded-For itself and a client's own value can't survive to this
# app — setting it when that's not true lets any client spoof their own IP
# and dodge rate limiting entirely. 1 matches the single reverse proxy
# DEPLOYMENT.md documents; raise it if your topology has more hops in front
# of that proxy (e.g. a CDN or an extra load balancer).
TRUST_PROXY_HOPS=

# Enables POST/GET /admin/tenants (tenant management). Unset disables the
# admin API entirely (503). Use a long random value, keep it secret. This is
# a single shared key with no per-person identity (every action it
# authenticates is recorded in the audit log as actor "admin") — see
# ADMIN_API_KEYS below if more than one person runs the admin API.
ADMIN_API_KEY=

# Optional, in addition to (or instead of) ADMIN_API_KEY: a comma-separated
# name:key list, e.g. alice:<long-random-value>,bob:<a-different-long-random-value>,
# so each person running the admin API holds their own key and the audit log
# (GET /admin/audit-log) records *who* took an action instead of an
# indistinguishable "admin" for everyone.
ADMIN_API_KEYS=

# Admin route rate limit, requests per 15 minutes per IP (default 30).
# Rarely needs changing in production — mainly useful if you drive many
# admin actions from one place in a short span (a UI test suite, a bulk
# onboarding script) and need more headroom than a human operator would.
LEADRECOVERY_ADMIN_RATE_LIMIT=30

# --- Optional: Paddle billing (auto-suspend/reactivate on subscription lapse/recovery) ---
# The signing secret for a Paddle Billing "notification destination" — from
# the Paddle dashboard, not a per-tenant credential (this is the *agency's*
# billing account, shared across every tenant). Enables POST /webhooks/paddle;
# unset (the default) disables it entirely (503) — tenant status is then
# only ever changed manually via the admin API. See "Billing (Paddle)" in
# DEPLOYMENT.md for the Paddle-side setup this expects (which events to
# send, and passing custom_data.tenantId at checkout).
PADDLE_WEBHOOK_SECRET=

# --- Worker (npm run worker) ---
# Cron expression for how often the recovery workflow runs across all
# tenants. Default: hourly.
LEADRECOVERY_CRON_SCHEDULE=0 * * * *

# Set to "true" to run the workflow once and exit instead of scheduling —
# useful when an external scheduler (cron, a platform's scheduled job) drives
# this instead of the built-in node-cron loop.
LEADRECOVERY_RUN_ONCE=false

# How many tenants the worker processes in parallel per tick (default 4).
# Only tunes concurrency *within* the single worker process — see
# DEPLOYMENT.md for why exactly one worker replica must run.
LEADRECOVERY_WORKER_CONCURRENCY=4

# --- Optional: Claude-based reply classification enhancement ---
# The keyword-based classifier (src/reply/classify.ts) is always used first
# and is what handles STOP/opt-out detection; this only adds an LLM pass for
# replies it can't confidently place. Leave both unset to stay fully offline.
LEADRECOVERY_USE_LLM_CLASSIFICATION=false
ANTHROPIC_API_KEY=

# --- Optional: operator alerting ---
# A webhook (Slack incoming webhook URL, or any endpoint that accepts a JSON
# POST with a `text` field) this app pings on its own operational problems —
# a fatal error about to crash the server/worker process, a worker tick
# failing outright, or a notification exhausting all its retries (see
# "Alerting" in DEPLOYMENT.md). Unset (the default): none of this fires;
# you'd only notice via logs. Distinct from a tenant's own notifyWebhookUrl,
# which is about a *lead's* reply, not this app's own health.
OPERATOR_ALERT_WEBHOOK_URL=
